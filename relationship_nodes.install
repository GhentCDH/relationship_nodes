<?php

/**
 * @file
 * Install, update and uninstall functions for the Relationship Nodes module.
 */

use Drupal\Core\Hook\Attribute\LegacyRequirementsHook;
use Drupal\relationship_nodes\Hook\RelationshipNodesHooks;

/**
 * Implements hook_requirements().
 *
 * Drupal 11.3+ uses RelationshipNodesHooks::runtimeRequirements() instead.
 */
#[LegacyRequirementsHook]
function relationship_nodes_requirements($phase) {
  if ($phase !== 'runtime') {
    return [];
  }
  return \Drupal::classResolver(RelationshipNodesHooks::class)->buildRequirements();
}

/**
 * Implements hook_uninstall().
 */
function relationship_nodes_uninstall($is_syncing) {
  $cleanupService = \Drupal::service('relationship_nodes.settings_cleanup_service');

  // Potentially, a lot of entity types need to be saved, which can take a
  // while. During a config sync, the imported configuration already has the
  // module's settings removed, so configuration entities are left alone.
  $cleanupService->removeModuleSettings(!$is_syncing);
}
